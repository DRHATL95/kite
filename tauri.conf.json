{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xbox Remote",
  "version": "0.2.0",
  "identifier": "com.xboxremote.app",
  "build": {
    "frontendDist": "./ui/dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Xbox Remote",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true,
        "focus": true,
        "decorations": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitea.howlab.co/dave/xbox-remote/releases/download/nightly/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRjBDRTQ4NEFCNTRCOTEKUldTUlM3VktTTTd3VDAzWng2WFdYbzVIUnNqa1BWdlUrYVZHTnk4YlBNNEhkTFVKcXpPaGV0U2gK"
    }
  }
}
