{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability: core, shell, updater, process, opener, store",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "updater:default",
    "process:allow-restart",
    "opener:default",
    "store:default"
  ]
}
